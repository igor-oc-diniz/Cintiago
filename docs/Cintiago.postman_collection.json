      "name": "Authentication",
      "item": [
        {
          "name": "Google OAuth - Iniciar Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{local}}/auth/google",
              "protocol": "http",
              "host": [
                "{{local}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Inicia o fluxo OAuth com o Google. Abrir no browser — redireciona para a tela de login do Google."
          },
          "response": []
        },
        {
          "name": "Dev Token (OPERATOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token', res.token);",
                  "console.log('Token salvo:', res.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{local}}/auth/dev-token",
              "protocol": "http",
              "host": [
                "{{local}}"
              ],
              "path": [
                "auth",
                "dev-token"
              ]
            },
            "description": "Gera um JWT de OPERATOR para testes locais e salva automaticamente em {{token}}. Não usar em produção."
          },
          "response": []
        },
        {
          "name": "Google OAuth - Callback",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{local}}/auth/google/callback",
              "protocol": "http",
              "host": [
                "{{local}}"
              ],
              "path": [
                "auth",
                "google",
                "callback"
              ]
            },
            "description": "Callback chamado automaticamente pelo Google após login. Não usar manualmente."
          },
          "response": []
        }
      ]
